  function attachmentMediaType(file) {
    const suffix=file.name.toLocaleLowerCase();
    if(suffix.endsWith(".md")||suffix.endsWith(".markdown"))return "text/markdown";
    if(suffix.endsWith(".txt"))return "text/plain";
